      "id": "22774c5d-047c-4b68-a83d-80001ac71c9a",
      "name": "Get FAQs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        230,
        300
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Nt0QGFAe5D9ZXv6B",
          "name": "Google Sheets account"
