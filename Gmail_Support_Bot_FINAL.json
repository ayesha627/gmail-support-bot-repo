      "id": "4341d484-032a-4093-b8cc-02f07ff75a66",
      "name": "Ignore (Automated)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $json;\nconst text = String(msg.message_text || '').toLowerCase();\nconst faqs = msg.faqs || [];\nlet best = null;\nlet bestScore = 0;\nfor (const f of faqs) {\n  const kws = String(f.keywords || '').toLowerCase().split(',').map(function (s) { return s.trim(); }).filter(Boolean);\n  let score = 0;\n  for (const k of kws) {\n    const safe = k.replace(/[.*+?^$(){}|[\\]\\\\]/g, '\\\\$&');\n    if (new RegExp('\\\\b' + safe + '\\\\b').test(text)) score++;\n  }\n  if (score > bestScore) { bestScore = score; best = f; }\n}\nconst context = faqs.map(function (f) { return 'Q: ' + f.question + '\\nA: ' + f.answer; }).join('\\n\\n');\nconst out = Object.assign({}, msg, { answered: bestScore > 0, answer: best ? String(best.answer) : '', faq_context: context });\ndelete out.faqs;\nreturn { json: out };"
      },
      "id": "0ff259ca-f3a0-4563-b9e2-c64e79702ca0",
      "name": "FAQ Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $json;\nconst sys = 'You are the assistant for a company customer-support inbox. This inbox also receives personal mail, so many emails are NOT support requests. ' +\n  'Step 1: decide if the email is a customer asking this company for help or information about its product or service ' +\n  '(account, login, password, plans, pricing, billing, refunds, installation, support hours, complaints, cancellation, security problems, talking to a human). ' +\n  'Newsletters, promotions, offers, internships, university or course announcements, job emails, social updates and personal conversations are NOT support. ' +\n  'Step 2: if it is support, answer ONLY from the FAQ below. If the FAQ does not clearly answer it, the answer must be exactly NO_ANSWER. ' +\n  'Never invent account, billing, security, pricing or technical information. Keep answers under 120 words, friendly, plain text, no greeting or sign-off, same language as the customer. ' +\n  'Return ONLY a JSON object, no markdown: {\"is_support\": true or false, \"answer\": \"answer text or NO_ANSWER\"}.\\n\\nFAQ:\\n' +\n  (m.faq_context || '(empty)');\nreturn { json: Object.assign({}, m, { ai_system: sys, ai_prompt: 'Customer email:\\n' + m.message_text }) };"
      },
      "id": "0eb102db-5009-46cb-bee4-6176c655113e",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        400
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "Gemini 2.5 Flash"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.ai_prompt }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
