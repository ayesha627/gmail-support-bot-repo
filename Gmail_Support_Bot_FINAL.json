    {
      "parameters": {
        "jsCode": "const faqs = $input.all().map(function (i) { return i.json; }).filter(function (f) { return f.question && f.answer; });\nconst emails = $('Gmail Trigger').all();\nconst out = [];\nfor (let idx = 0; idx < emails.length; idx++) {\n  const j = emails[idx].json;\n  const fromObj = (j.from && j.from.value && j.from.value[0]) || {};\n  const email = String(fromObj.address || '').trim().toLowerCase();\n  let name = String(fromObj.name || '').replace(/\"/g, '').trim();\n  if (!name || name.indexOf('@') !== -1) name = 'there';\n  const subject = j.subject || '(no subject)';\n  let body = String(j.text || j.snippet || '');\n  body = body.split(/\\r?\\nOn .{5,200} wrote:/)[0].split(/\\r?\\n>/)[0].trim().slice(0, 2000);\n  const automated = !email || /(no-?reply|donotreply|mailer-daemon|postmaster|notifications?@|newsletter|bounce)/i.test(email) || /^\\[Support Escalation/i.test(subject);\n  out.push({\n    json: {\n      customer_email: email,\n      customer_name: name,\n      subject: subject,\n      message_text: (subject + '\\n' + body).trim(),\n      message_id: j.id,\n      thread_id: j.threadId,\n      received_at: new Date().toISOString(),\n      ticket_id: 'TKT-' + (Date.now() + idx).toString(36).toUpperCase(),\n      is_automated: automated,\n      faqs: faqs\n    },\n    pairedItem: { item: 0 }\n  });\n}\nreturn out;"
      },
