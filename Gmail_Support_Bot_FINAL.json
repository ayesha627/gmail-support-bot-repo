    {
      "id": "5b762b3a-0cca-4280-bf03-2433eca9d33c",
      "name": "How it works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "width": 760,
        "height": 300,
        "content": "## Gmail Support Bot\nGmail Trigger (unread inbox, every minute) -> load FAQs from Google Sheet -> skip automated senders -> FAQ keyword match -> Gemini decides if the email is a real support request and answers ONLY from the FAQ.\n\n- Answer found -> auto-reply in thread -> mark read\n- Urgent keyword / no reliable answer -> log ticket in Sheet -> notify agent -> holding reply with ticket ID -> mark read\n- Not a support email (personal/newsletter) -> left untouched and unread\n- If Gemini fails, keyword/urgent rules are used so no email is lost"
      }
    }
