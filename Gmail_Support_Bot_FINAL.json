          "temperature": 0.2,
          "thinkingBudget": 0
        }
      },
      "id": "f4ff1a4c-14be-49b1-9085-e6733fe29c9e",
      "name": "Gemini AI",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1380,
        400
      ],
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let src;\ntry { src = $('Build AI Request').item.json; } catch (e) { src = $('Build AI Request').all()[$itemIndex].json; }\nconst j = $json || {};\nfunction partsText(parts) { return (parts || []).map(function (p) { return (p && p.text) || ''; }).join(''); }\nlet t = '';\nif (j.content && Array.isArray(j.content.parts)) t = partsText(j.content.parts);\nelse if (typeof j.text === 'string') t = j.text;\nelse if (typeof j.content === 'string') t = j.content;\nelse if (Array.isArray(j.candidates) && j.candidates[0] && j.candidates[0].content) t = partsText(j.candidates[0].content.parts);\nt = String(t || '');\nlet parsed = {};\nconst a = t.indexOf('{');\nconst b = t.lastIndexOf('}');\nif (a !== -1 && b > a) { try { parsed = JSON.parse(t.slice(a, b + 1)); } catch (e) { parsed = {}; } }\nconst aiWorked = Object.keys(parsed).length > 0;\nconst aiAnswer = String(parsed.answer || '').trim();\nconst aiOk = aiAnswer.length > 0 && aiAnswer.indexOf('NO_ANSWER') === -1;\nconst urgent = /\\b(human|agent|urgent|refund|billing|complaint|hacked|security|chargeback|cancel)\\b/i.test(String(src.message_text || ''));\nconst kwHit = src.answered === true && String(src.answer || '').length > 0;\n// If Gemini failed, do not silently drop the email: fall back to keyword/urgent rules.\nconst isSupport = aiWorked ? (parsed.is_support === true || parsed.is_support === 'true') : (kwHit || urgent);\nconst out = Object.assign({}, src, {\n  is_support: isSupport,\n  urgent: urgent,\n  answered: kwHit ? true : aiOk,\n  answer: kwHit ? src.answer : (aiOk ? aiAnswer : '')\n});\ndelete out.ai_system;\ndelete out.ai_prompt;\ndelete out.faq_context;\nreturn { json: out };"
      },
